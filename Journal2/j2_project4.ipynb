   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "ced8a4f4-d786-4d74-bd1d-a99bd6675e06",
   "metadata": {},
   "outputs": [],
   "source": [
    "y = np.random.laplace(0, 1, 1000)\n",
    "counts, bins = np.histogram(y, 100)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "93d03964-697d-479c-a92f-d506c60e6a68",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.hist(bins[:-1], bins, weights=counts)\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.title(\"Randomly Pulled Laplace Values\")\n",
    "plt.show()"
   ]
  }
